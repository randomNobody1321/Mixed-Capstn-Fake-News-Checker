  m_Script: {fileID: 11500000, guid: d620033edbd38f84e94d033dd3a73eb4, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::OnboardingTutorialManager
  leftDisplayImage: {fileID: 1202508271}
  rightDialogueText: {fileID: 1687383447}
  nextButtonLabel: {fileID: 0}
  appWindowPanelObject: {fileID: 389967406}
  grandmaProfilePanelObject: {fileID: 1830572740}
  helperLifelineWidgetObject: {fileID: 1925409876}
  batteryHudObject: {fileID: 419862558}
  helperActionButton: {fileID: 859759311}
  slides:
  - slideImage: {fileID: -4101669884222336352, guid: 30def03c826616441a823fb8a0d5ce14, type: 3}
    slideText: "Hey There !  I\u2019m your handy lil Helper !"
  - slideImage: {fileID: -4101669884222336352, guid: 30def03c826616441a823fb8a0d5ce14, type: 3}
    slideText: You can call me Helpy !
  - slideImage: {fileID: -3210815410470974165, guid: ba91e59969516374b8bab678ec12f3a9, type: 3}
    slideText: Always remember to be careful on the web !
  - slideImage: {fileID: -3210815410470974165, guid: ba91e59969516374b8bab678ec12f3a9, type: 3}
    slideText: Make sure to check the comments and links !
  - slideImage: {fileID: -4101669884222336352, guid: 30def03c826616441a823fb8a0d5ce14, type: 3}
    slideText: They can help you determine the posts validity !
  - slideImage: {fileID: -3210815410470974165, guid: ba91e59969516374b8bab678ec12f3a9, type: 3}
    slideText: If you see some fake news then report it !
  - slideImage: {fileID: -4101669884222336352, guid: 30def03c826616441a823fb8a0d5ce14, type: 3}
    slideText: But if you think its real, then share it with everyone !
  - slideImage: {fileID: -3210815410470974165, guid: ba91e59969516374b8bab678ec12f3a9, type: 3}
    slideText: If ever you find yourself unsure of a post...
  - slideImage: {fileID: -4101669884222336352, guid: 30def03c826616441a823fb8a0d5ce14, type: 3}
    slideText: Then you can click on me and I can Help !
  - slideImage: {fileID: -3210815410470974165, guid: ba91e59969516374b8bab678ec12f3a9, type: 3}
    slideText: Now go out there and be a beacon of truth !
  - slideImage: {fileID: -4101669884222336352, guid: 30def03c826616441a823fb8a0d5ce14, type: 3}
    slideText: "Wouldn\u2019t want ya getting banned for misinformation !"
  - slideImage: {fileID: -3210815410470974165, guid: ba91e59969516374b8bab678ec12f3a9, type: 3}
    slideText: Good luck !
