  dialogueName: Guard Meeting
  nodes:
  - speakerName: Guard
    speakerMessage: "\u2022 Halt! This area is restricted. State your business."
    choices:
    - choiceButtonText: I am Lost.
      playerResponseBubbleText: Sorry, I'm just exploring and got lost.
